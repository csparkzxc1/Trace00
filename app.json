{
  "expo": {
    "name": "영성훈련",
    "slug": "spiritual-checklist",
    "scheme": "spiritualchecklist",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spiritualchecklist.app",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.spiritualchecklist.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#7C9885"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
